{
  "name": "gigli",
  "version": "3.0.0",
  "description": "Gigli: High-performance, type-safe isomorphic JavaScript and TypeScript validation engine for MERN stack, Node.js, and web browsers with built-in security, schema inference, decorator models, string rules, and OpenAPI/JSON Schema generation.",
  "author": "Junaid Ali Shah Gigli",
  "license": "MIT",
  "homepage": "https://github.com/jasgigli/gigli-validator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasgigli/gigli-validator.git"
  },
  "bugs": {
    "url": "https://github.com/jasgigli/gigli-validator/issues"
  },
  "keywords": [
    "gigli",
    "validex",
    "validation",
    "validator",
    "typescript",
    "javascript",
    "zod",
    "yup",
    "joi",
    "class-validator",
    "schema",
    "typesafe",
    "inference",
    "mern",
    "express",
    "react",
    "isomorphic",
    "sanitization",
    "xss",
    "security"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "bin": {
    "gigli": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm test && npm run build",
    "release": "npm run prepublishOnly && npm publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
