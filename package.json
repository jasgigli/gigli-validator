{
  "name": "gigli",
  "version": "3.0.0",
  "description": "Gigli: High-performance, type-safe isomorphic JavaScript and TypeScript validation engine for MERN stack, Node.js, and web browsers with built-in security, schema inference, decorator models, string rules, and OpenAPI/JSON Schema generation.",
  "author": "Junaid Ali Shah Gigli",
  "license": "MIT",
  "homepage": "https://github.com/jasgigli/gigli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasgigli/gigli.git"
  },
  "bugs": {
    "url": "https://github.com/jasgigli/gigli/issues"
  },
  "keywords": [
    "gigli",
    "validex",
    "validation",
    "validator",
    "typescript",
    "javascript",
    "zod",
    "yup",
    "joi",
    "class-validator",
    "schema",
    "typesafe",
    "inference",
    "mern",
    "express",
    "react",
    "isomorphic",
    "sanitization",
    "xss",
    "security"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "bin": {
    "gigli": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm test && npm run build",
    "release": "npm run prepublishOnly && npm publish"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.4.5"
  }
}
